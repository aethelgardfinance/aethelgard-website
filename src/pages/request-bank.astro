---
import '../styles/global.css';

const DOWNLOAD_WIN = 'https://github.com/aethelgardfinance/aethelgard-releases/releases';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Request support for your bank or broker's statement format in Aethelgard. Share only a redacted sample — never your real financial data." />
  <title>Request a bank — Aethelgard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="Request a bank — Aethelgard" />
  <meta property="og:description" content="Ask us to support your bank or broker. Share only a redacted format sample — never real data." />
  <meta property="og:url" content="https://aethelgard.finance/request-bank" />
  <meta property="og:type" content="website" />
</head>

<body class="bg-white text-neutral-900 antialiased">

  <!-- Navigation -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-navy-900/95 backdrop-blur-sm border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/favicon.svg" alt="Aethelgard" class="h-7 w-7 rounded-lg shadow-lg" />
        <span class="font-black text-white tracking-tighter uppercase italic text-lg">Aethelgard</span>
      </a>
      <a href={DOWNLOAD_WIN} class="btn-primary text-sm py-2 px-4">
        Download
        <span class="text-white/60 font-normal text-xs">Windows</span>
      </a>
    </div>
  </nav>

  <!-- Request form -->
  <section class="pt-32 pb-24 px-6 bg-white min-h-screen">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <p class="section-label mb-3">Request a bank</p>
        <h1 class="text-4xl font-black tracking-tighter text-neutral-900 mb-4">Don't see your bank?</h1>
        <p class="text-neutral-500 leading-relaxed">
          Tell us which bank or broker you'd like Aethelgard to import, and we'll build support for it —
          shipped to everyone in a future update. It helps enormously if you paste a small
          <strong>redacted</strong> sample of the file's format so we can match the columns.
        </p>
      </div>

      <!-- Privacy notice -->
      <div class="bg-amber-50 border border-amber-200 rounded-2xl px-6 py-5 mb-8">
        <p class="text-sm font-bold text-amber-800 uppercase tracking-wider mb-2">Never send real financial data</p>
        <p class="text-sm text-amber-900/80 leading-relaxed">
          Aethelgard is private by design. Do <strong>not</strong> paste real balances, amounts, account numbers or names.
          Send only the <strong>column headers</strong> and 1&ndash;3 example rows with every real value replaced by a placeholder
          &mdash; e.g. dates as <code>2020-01-01</code>, amounts as <code>1234.56</code>, text as <code>SAMPLE</code>.
          The structure is all we need.
        </p>
      </div>

      <form id="request-bank-form" class="flex flex-col gap-4 text-left">
        <div class="flex flex-col gap-1">
          <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider" for="rb-bank">Bank or broker</label>
          <input type="text" id="rb-bank" name="bank" placeholder="e.g. Monzo, Trading 212, HSBC" required maxlength="100"
            class="px-5 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
        </div>

        <div class="flex flex-col gap-1">
          <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider" for="rb-country">Country <span class="text-neutral-400 normal-case font-normal">(optional)</span></label>
          <input type="text" id="rb-country" name="country" placeholder="e.g. United Kingdom" maxlength="100"
            class="px-5 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-xs font-bold text-neutral-600 uppercase tracking-wider">Statement format</span>
          <div class="flex gap-6 mt-1">
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-neutral-700">
              <input type="radio" name="format" value="CSV" class="accent-brand-500" required /> CSV / spreadsheet
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-sm font-semibold text-neutral-700">
              <input type="radio" name="format" value="PDF" class="accent-brand-500" /> PDF
            </label>
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider" for="rb-email">Your email</label>
          <input type="email" id="rb-email" name="email" placeholder="your@email.com" required maxlength="254"
            class="px-5 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500" />
          <p class="text-[11px] text-neutral-400">So we can let you know when your bank is supported.</p>
        </div>

        <div class="flex flex-col gap-1">
          <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider" for="rb-sample">Redacted format sample <span class="text-neutral-400 normal-case font-normal">(optional, but very helpful)</span></label>
          <textarea id="rb-sample" name="sample" rows="5" maxlength="5000"
            placeholder="Date,Description,Amount&#10;2020-01-01,SAMPLE MERCHANT,1234.56&#10;2020-01-02,SAMPLE MERCHANT,-99.00"
            class="px-5 py-3 rounded-xl border border-neutral-200 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 resize-none"></textarea>
          <p class="text-[11px] text-neutral-400">Headers + a couple of rows with all values faked. No real data.</p>
        </div>

        <div class="flex flex-col gap-1">
          <label class="text-xs font-bold text-neutral-600 uppercase tracking-wider" for="rb-notes">Anything else <span class="text-neutral-400 normal-case font-normal">(optional)</span></label>
          <textarea id="rb-notes" name="notes" rows="2" maxlength="2000"
            class="px-5 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 resize-none"></textarea>
        </div>

        <label class="flex items-start gap-3 cursor-pointer mt-2">
          <input type="checkbox" id="rb-attest" name="attest" required class="accent-amber-500 mt-1 shrink-0" />
          <span class="text-sm text-neutral-600 leading-snug">I confirm this submission contains <strong>no real financial data</strong> — only a redacted or made-up sample.</span>
        </label>

        <button type="submit" class="btn-primary py-3 px-8 justify-center mt-2">
          Send request
        </button>
      </form>
      <p class="text-[10px] text-neutral-400 mt-4 uppercase tracking-widest font-bold text-center">Private by design · No real data · No spam</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-navy-900 border-t border-white/5 px-6 py-10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/favicon.svg" alt="Aethelgard" class="h-6 w-6 rounded-md" />
        <span class="font-black text-white/80 tracking-tighter uppercase italic">Aethelgard</span>
      </a>
      <p class="text-white/30 text-xs text-center">
        &copy; {new Date().getFullYear()} Aethelgard · A product of Aethelgard Finance Ltd ·
        <a href="mailto:contact@aethelgard.finance" class="hover:text-white/60 transition-colors ml-1">contact@aethelgard.finance</a>
      </p>
      <div class="flex items-center gap-6 text-xs text-white/30 font-medium">
        <a href="/" class="hover:text-white/60 transition-colors">Home</a>
        <a href="/guides" class="hover:text-white/60 transition-colors">Guides</a>
        <a href="/privacy" class="hover:text-white/60 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white/60 transition-colors">Terms</a>
      </div>
    </div>
  </footer>

</body>

<script is:inline>
  const REQUEST_BANK_API = 'https://aethelgard-licensing.vercel.app/api/request-bank';
  const LOG_FAILURE_API = 'https://aethelgard-licensing.vercel.app/api/log-form-failure';

  // Best-effort observability beacon — scrubbed of PII, only context + brief error.
  function reportFailure(context, errorBrief, status) {
    try {
      const payload = JSON.stringify({
        context: String(context).slice(0, 60),
        errorBrief: String(errorBrief || '').slice(0, 200),
        status: typeof status === 'number' ? status : null,
      });
      if (navigator.sendBeacon) {
        navigator.sendBeacon(LOG_FAILURE_API, new Blob([payload], { type: 'application/json' }));
      } else {
        fetch(LOG_FAILURE_API, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: payload, keepalive: true,
        }).catch(() => {});
      }
    } catch {}
  }

  // Prefill non-sensitive context passed from the desktop app's deep link.
  const params = new URLSearchParams(window.location.search);
  const ctxFormat = (params.get('format') || '').toUpperCase();
  if (ctxFormat === 'CSV' || ctxFormat === 'PDF') {
    const radio = document.querySelector('input[name="format"][value="' + ctxFormat + '"]');
    if (radio) radio.checked = true;
  }
  const ctxJur = params.get('jur');
  if (ctxJur) {
    const country = document.getElementById('rb-country');
    if (country && !country.value) country.value = ctxJur;
  }
  const ctxTier = (params.get('tier') || '').slice(0, 50);
  const ctxVersion = (params.get('v') || '').slice(0, 20);

  const form = document.getElementById('request-bank-form');
  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const attest = this.querySelector('input[name="attest"]');
      if (!attest || !attest.checked) {
        alert('Please confirm the sample contains no real financial data.');
        return;
      }
      const bank = this.querySelector('input[name="bank"]').value.trim();
      const country = this.querySelector('input[name="country"]').value.trim();
      const formatEl = this.querySelector('input[name="format"]:checked');
      const format = formatEl ? formatEl.value : '';
      const email = this.querySelector('input[name="email"]').value.trim();
      const sample = this.querySelector('textarea[name="sample"]').value.trim();
      const notes = this.querySelector('textarea[name="notes"]').value.trim();
      const btn = this.querySelector('button[type="submit"]');
      btn.disabled = true;
      btn.textContent = 'Sending…';
      let lastStatus = 0;
      try {
        const res = await fetch(REQUEST_BANK_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'request-bank',
            bank, country, format, email, sample, notes,
            tier: ctxTier || undefined,
            appVersion: ctxVersion || undefined,
          }),
        });
        lastStatus = res.status;
        if (!res.ok) throw new Error('Server error ' + res.status);
        this.outerHTML = '<p class="text-brand-500 font-bold text-lg text-center">Thank you — your request for ' + bank.replace(/[<>&]/g, '') + ' is in. We\'ll email ' + email.replace(/[<>&]/g, '') + ' when it\'s supported.</p>';
      } catch (err) {
        reportFailure('request-bank', err && err.message, lastStatus);
        btn.disabled = false;
        btn.textContent = 'Send request';
        alert('Something went wrong. Please email contact@aethelgard.finance directly.');
      }
    });
  }
</script>
</html>
