---
import '../styles/global.css';

const DOWNLOAD_WIN = 'https://github.com/aethelgardfinance/aethelgard-releases/releases';

const regions = [
  { name: 'United Kingdom', banks: ['HSBC', 'Barclays', 'Santander UK', 'Starling Bank'] },
  { name: 'United States', banks: ['Chase', 'Bank of America'] },
  { name: 'Netherlands', banks: ['ING', 'ABN AMRO', 'Rabobank'] },
  { name: 'Spain', banks: ['BBVA', 'CaixaBank', 'Santander'] },
  { name: 'Mexico', banks: ['BBVA México', 'Banamex'] },
  { name: 'Portugal', banks: ['Millennium BCP'] },
  { name: 'Suriname', banks: ['DSB'] },
];
const brokers = ['Interactive Brokers', 'Charles Schwab', 'Degiro', 'IG — UK share dealing & CFD', 'Wise'];
const cards = ['American Express'];
const universal = [
  { name: 'OFX / QFX', note: 'the standard bank-export format — most banks worldwide offer it' },
  { name: 'QIF (Quicken)', note: 'legacy Quicken export' },
  { name: 'Custom CSV', note: 'a visual column mapper for any spreadsheet Aethelgard doesn’t recognise' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Banks, brokers and file formats Aethelgard imports — with named support across the UK, US and Europe, plus OFX/QIF/CSV for any institution." />
  <title>Supported banks & brokers — Aethelgard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="Supported banks & brokers — Aethelgard" />
  <meta property="og:description" content="Named support across the UK, US and Europe, plus OFX/QIF/CSV for any bank. Don't see yours? Request it." />
  <meta property="og:url" content="https://aethelgard.finance/supported-banks" />
  <meta property="og:type" content="website" />
</head>

<body class="bg-white text-neutral-900 antialiased">

  <!-- Navigation -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-navy-900/95 backdrop-blur-sm border-b border-white/5">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/favicon.svg" alt="Aethelgard" class="h-7 w-7 rounded-lg shadow-lg" />
        <span class="font-black text-white tracking-tighter uppercase italic text-lg">Aethelgard</span>
      </a>
      <a href={DOWNLOAD_WIN} class="btn-primary text-sm py-2 px-4">
        Download
        <span class="text-white/60 font-normal text-xs">Windows</span>
      </a>
    </div>
  </nav>

  <!-- Header -->
  <section class="pt-32 pb-12 px-6 bg-navy-900">
    <div class="max-w-4xl mx-auto text-center">
      <p class="section-label mb-3">Imports</p>
      <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-white mb-5">Supported banks &amp; brokers</h1>
      <p class="text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
        Aethelgard reads statements from the institutions below directly. And because it also imports
        the universal <strong class="text-white/80">OFX</strong>, <strong class="text-white/80">QIF</strong>
        and <strong class="text-white/80">CSV</strong> formats, it works with virtually
        <strong class="text-white/80">any</strong> bank — named or not.
      </p>
    </div>
  </section>

  <!-- Named banks by region -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {regions.map(region => (
          <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-6">
            <p class="text-xs font-black text-brand-500 uppercase tracking-widest mb-4">{region.name}</p>
            <ul class="space-y-2">
              {region.banks.map(bank => (
                <li class="flex items-center gap-2 text-sm font-semibold text-neutral-800">
                  <span class="text-brand-500">&#10003;</span> {bank}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Brokers + cards -->
      <div class="grid sm:grid-cols-2 gap-6 mt-6">
        <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-6">
          <p class="text-xs font-black text-brand-500 uppercase tracking-widest mb-4">Brokers &amp; investment platforms</p>
          <ul class="space-y-2">
            {brokers.map(b => (
              <li class="flex items-center gap-2 text-sm font-semibold text-neutral-800"><span class="text-brand-500">&#10003;</span> {b}</li>
            ))}
          </ul>
        </div>
        <div class="bg-neutral-50 border border-neutral-200 rounded-2xl p-6">
          <p class="text-xs font-black text-brand-500 uppercase tracking-widest mb-4">Cards</p>
          <ul class="space-y-2">
            {cards.map(c => (
              <li class="flex items-center gap-2 text-sm font-semibold text-neutral-800"><span class="text-brand-500">&#10003;</span> {c}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Universal formats -->
  <section class="py-16 px-6 bg-neutral-50 border-t border-neutral-100">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <p class="section-label mb-3">Any bank</p>
        <h2 class="text-3xl font-black tracking-tighter text-neutral-900">Even the ones not listed</h2>
        <p class="text-neutral-500 mt-3 max-w-2xl mx-auto">Almost every bank in the world can export one of these. If yours does, Aethelgard imports it.</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-6">
        {universal.map(u => (
          <div class="bg-white border border-neutral-200 rounded-2xl p-6 text-center">
            <p class="font-black text-neutral-900 mb-2">{u.name}</p>
            <p class="text-xs text-neutral-500 leading-relaxed">{u.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Request CTA -->
  <section class="py-20 px-6 bg-navy-900">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-black tracking-tighter text-white mb-4">Don't see your bank?</h2>
      <p class="text-white/60 text-lg mb-8 leading-relaxed">
        Ask us to add native support. You share only your file's <strong class="text-white/80">format</strong> —
        never any real financial data — and we build it for everyone.
      </p>
      <a href="/request-bank" class="btn-primary text-base px-8 py-3.5">Request your bank &rarr;</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-navy-900 border-t border-white/5 px-6 py-10">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/favicon.svg" alt="Aethelgard" class="h-6 w-6 rounded-md" />
        <span class="font-black text-white/80 tracking-tighter uppercase italic">Aethelgard</span>
      </a>
      <p class="text-white/30 text-xs text-center">
        &copy; {new Date().getFullYear()} Aethelgard · A product of Aethelgard Finance Ltd ·
        <a href="mailto:contact@aethelgard.finance" class="hover:text-white/60 transition-colors ml-1">contact@aethelgard.finance</a>
      </p>
      <div class="flex items-center gap-6 text-xs text-white/30 font-medium">
        <a href="/" class="hover:text-white/60 transition-colors">Home</a>
        <a href="/request-bank" class="hover:text-white/60 transition-colors">Request a bank</a>
        <a href="/privacy" class="hover:text-white/60 transition-colors">Privacy</a>
        <a href="/terms" class="hover:text-white/60 transition-colors">Terms</a>
      </div>
    </div>
  </footer>

</body>
</html>
